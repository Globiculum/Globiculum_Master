
# Copy this file to .env and fill in your values

# Supabase credentials (use Service Role key — bypasses RLS for data ingestion)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API key (for generating embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Data paths (relative to rag-backend/ folder, or use absolute paths)
NCERT_DATA_PATH=../Data collection for RAG/Ncret
US_CC_DATA_PATH=../Data collection for RAG/Us/us_common_core_concepts_CLEAN.xlsx

# Embedding model (default: text-embedding-3-small — 1536 dims, cheaper than ada-002)
EMBEDDING_MODEL=text-embedding-3-small

# Batch size for DB inserts (reduce if you hit Supabase request size limits)
INSERT_BATCH_SIZE=50

# Embedding batch size (OpenAI allows up to 2048 texts per request)
EMBEDDING_BATCH_SIZE=100
