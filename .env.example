# Root environment file for LOCAL development (RAG pipeline + backend scripts).

# Supabase project URL (shared)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase keys (NEVER expose service_role in the frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM / embedding provider keys
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key   # Used for text-embedding-3-small embeddings

# Common Standards Project API (US standards ingestion)
CSP_API_KEY=your-csp-api-key

# Email
RESEND_API_KEY=your-resend-api-key
